# Google Gemini API Key (required)
# Get your key from: https://makersuite.google.com/app/apikey
GOOGLE_API_KEY=your_api_key_here

# Chainlit Auth Secret (Run 'chainlit create-secret' to generate one)
CHAINLIT_AUTH_SECRET=your_random_secret_string

# Google OAuth Credentials (for "Login with Google")
# Create these in Google Cloud Console: https://console.cloud.google.com/apis/credentials
OAUTH_GOOGLE_CLIENT_ID=your_client_id
OAUTH_GOOGLE_CLIENT_SECRET=your_client_secret

# Optional: Qdrant Vector Database URL
# Leave empty to use in-memory fallback
# QDRANT_URL=http://localhost:6333